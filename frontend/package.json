{
  "name": "pathwise-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"eslint.config.js\" \"vite.config.js\" \"package.json\" \"index.html\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"eslint.config.js\" \"vite.config.js\" \"package.json\" \"index.html\"",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
